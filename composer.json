{
    "name": "schachbulle/contao-schachquiz-bundle",
    "type": "contao-bundle",
    "description": "Schachquiz für Contao: Themen mit Single- und Multiple-Choice-Fragen, optional mit Stellungsdiagramm, Glicko-2-Wertung für Mitglieder und Gäste, Rangliste, animierte Schachfiguren sowie Import aus CSV und JSON.",
    "keywords": [
        "contao",
        "schach",
        "quiz",
        "glicko",
        "elo",
        "rangliste",
        "multiple choice",
        "fen"
    ],
    "homepage": "https://github.com/Samson1964/contao-schachquiz-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.0",
        "doctrine/dbal": "^3.3 || ^4.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/security-core": "^5.4 || ^6.4 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoSchachquizBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoSchachquizBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoSchachquizBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-schachquiz-bundle/issues",
        "source": "https://github.com/Samson1964/contao-schachquiz-bundle"
    }
}
